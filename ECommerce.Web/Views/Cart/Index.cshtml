@model CartIndexViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container-fluid bg-secondary mb-5">
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px">
        <h1 class="font-weight-semi-bold text-uppercase mb-3">Shopping Cart</h1>
        <div class="d-inline-flex">
            <p class="m-0"><a asp-controller="Home" asp-action="Index">Home</a></p>
            <p class="m-0 px-2">-</p>
            <p class="m-0"><a asp-controller="Products" asp-action="Index">Shop</a></p>
            <p class="m-0 px-2">-</p>
            <p class="m-0">Cart</p>
        </div>
    </div>
</div>

<div class="container-fluid pt-5">
    <div class="row px-xl-5">
        @if (Model.HasItems)
        {
            <div class="col-lg-8 table-responsive mb-5">
                <table class="table table-bordered text-center mb-0">
                    <thead class="bg-secondary text-dark">
                        <tr>
                            <th>Product</th>
                            <th>Name</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Remove</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="align-middle" style="width: 140px;">
                                    <img src="@StorefrontAssetHelper.GetProductImage(item.ProductId, item.ImageUrl)"
                                         alt="@item.ProductName"
                                         class="img-fluid"
                                         style="max-height: 90px;" />
                                </td>
                                <td class="align-middle text-left">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark font-weight-semi-bold">
                                        @item.ProductName
                                    </a>
                                </td>
                                <td class="align-middle">@item.Price.ToString("C")</td>
                                <td class="align-middle">
                                    <div class="input-group cart-quantity mx-auto" style="width: 140px;">
                                        <div class="input-group-btn">
                                            <form asp-controller="Cart" asp-action="Decrease" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm btn-primary cart-btn-minus">
                                                    <i class="fa fa-minus"></i>
                                                </button>
                                            </form>
                                        </div>
                                        <input type="text" class="form-control form-control-sm bg-secondary text-center" value="@item.Quantity" readonly />
                                        <div class="input-group-btn">
                                            <form asp-controller="Cart" asp-action="Increase" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm btn-primary cart-btn-plus">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle">@((item.Price * item.Quantity).ToString("C"))</td>
                                <td class="align-middle">
                                    <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-lg-4">
                <div class="card border-secondary mb-5">
                    <div class="card-header bg-secondary border-0">
                        <h4 class="font-weight-semi-bold m-0">Cart Summary</h4>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3 pt-1">
                            <h6 class="font-weight-medium">Items</h6>
                            <h6 class="font-weight-medium">@Model.Items.Sum(item => item.Quantity)</h6>
                        </div>
                        <div class="d-flex justify-content-between">
                            <h5 class="font-weight-bold">Order Total</h5>
                            <h5 class="font-weight-bold">@Model.OrderTotal.ToString("C")</h5>
                        </div>
                    </div>
                    <div class="card-footer border-secondary bg-transparent">
                        <div class="d-flex flex-column">
                            <a asp-controller="Products" asp-action="Index" class="btn btn-block btn-outline-primary my-2">Continue Shopping</a>
                            <form asp-controller="Cart" asp-action="Clear" method="post">
                                <button type="submit" class="btn btn-block btn-primary my-2">Clear Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <p>Your cart is empty right now.</p>
                    <div class="dashboard-actions justify-content-center">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Browse Products</a>
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary">Browse Categories</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
