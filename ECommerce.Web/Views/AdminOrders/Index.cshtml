@model IReadOnlyList<OrderSummaryDto>
@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="page-header">
                <div>
                    <h1>Manage Orders</h1>
                    <p class="text-muted mb-0">Review customer orders and payment status.</p>
                </div>
                <a asp-controller="Products" asp-action="Admin" class="btn btn-outline-secondary">Product Admin</a>
            </div>
            <div class="card card-shadow border-0">
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <p>No customer orders found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Customer</th>
                                        <th>Date</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th class="table-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td>#@order.Id</td>
                                            <td>
                                                <div>@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Customer" : order.CustomerName)</div>
                                                <small class="text-muted">@order.CustomerEmail</small>
                                            </td>
                                            <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                                            <td>@order.TotalAmount.ToString("C")</td>
                                            <td>@order.Status</td>
                                            <td class="table-actions">
                                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
