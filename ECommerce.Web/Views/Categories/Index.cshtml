@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <div>
        <h1>Categories</h1>
        <p class="text-muted mb-0">Manage product categories through the service layer.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Category</a>
</div>

<div class="card card-shadow border-0">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No categories have been created yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(category.Description) ? "No description provided." : category.Description)</td>
                                <td class="table-actions">
                                    <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
