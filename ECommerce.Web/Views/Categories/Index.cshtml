@model IReadOnlyList<StoreCategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid bg-secondary mb-5">
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px">
        <h1 class="font-weight-semi-bold text-uppercase mb-3">Categories</h1>
        <div class="d-inline-flex">
            <p class="m-0"><a asp-controller="Home" asp-action="Index">Home</a></p>
            <p class="m-0 px-2">-</p>
            <p class="m-0">Categories</p>
        </div>
    </div>
</div>

<div class="container-fluid pt-5">
    <div class="text-center mb-4">
        <h2 class="section-title px-5"><span class="px-2">Browse By Category</span></h2>
    </div>
    <div class="row px-xl-5 pb-3">
        @if (Model.Any())
        {
            @foreach (var category in Model)
            {
                <div class="col-lg-4 col-md-6 pb-1">
                    <div class="cat-item d-flex flex-column border mb-4" style="padding: 30px;">
                        <p class="text-right">@category.ProductCount Products</p>
                        <a asp-controller="Products"
                           asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           class="cat-img position-relative overflow-hidden mb-3">
                            <img class="img-fluid" src="@category.ImageUrl" alt="@category.Name">
                        </a>
                        <h5 class="font-weight-semi-bold m-0 mb-2">@category.Name</h5>
                        <p class="text-muted mb-3">
                            @(string.IsNullOrWhiteSpace(category.Description)
                                ? "Explore products grouped under this category."
                                : category.Description)
                        </p>
                        <a asp-controller="Products"
                           asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           class="btn btn-outline-primary mt-auto">
                            View Products
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <p>No categories are available yet.</p>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Browse Products</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="container-fluid bg-secondary my-5">
    <div class="row justify-content-md-center py-5 px-xl-5">
        <div class="col-md-7 col-12 py-5 text-center">
            <h2 class="section-title px-5 mb-3"><span class="bg-secondary px-2">Find What You Need</span></h2>
            <p class="mb-4">Choose a category first, then browse matching products from the storefront view.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary px-4 py-2">Go To Shop</a>
        </div>
    </div>
</div>
