@model CategoryDto
@{
    ViewData["Title"] = "Category Details";
}

<div class="page-header">
    <div>
        <h1>Category Details</h1>
        <p class="text-muted mb-0">Review category information.</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Admin" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="card card-shadow border-0">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd>
        </dl>
    </div>
</div>
