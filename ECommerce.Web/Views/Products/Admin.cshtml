@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="page-header">
                <div>
                    <h1>Manage Products</h1>
                    <p class="text-muted mb-0">Keep the admin CRUD flow while the storefront uses the same real product data.</p>
                </div>
                <div class="dashboard-actions">
                    <a asp-action="Index" class="btn btn-outline-primary">View Shop</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Home</a>
                    <a asp-action="Create" class="btn btn-primary">Create Product</a>
                </div>
            </div>

            <div class="card card-shadow border-0">
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <p>No products have been created yet.</p>
                            <a asp-action="Create" class="btn btn-primary">Create Product</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th class="table-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model)
                                    {
                                        <tr>
                                            <td>@product.Name</td>
                                            <td>@product.CategoryName</td>
                                            <td>@product.Price.ToString("C")</td>
                                            <td>@product.StockQuantity</td>
                                            <td class="table-actions">
                                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Preview</a>
                                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
