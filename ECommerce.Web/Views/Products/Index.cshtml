@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="page-header">
    <div>
        <h1>Products</h1>
        <p class="text-muted mb-0">Manage products through the business service layer.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Product</a>
</div>

<div class="card card-shadow border-0">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No products have been created yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.CategoryName</td>
                                <td>@product.Price.ToString("C")</td>
                                <td>@product.StockQuantity</td>
                                <td class="table-actions">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
