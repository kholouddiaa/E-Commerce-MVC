@model StorefrontProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    ViewData["ProductCardColumnClass"] = "col-lg-3 col-md-6 col-sm-12 pb-1";
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container-fluid bg-secondary mb-5">
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px">
        <h1 class="font-weight-semi-bold text-uppercase mb-3">@Model.Product.Name</h1>
        <div class="d-inline-flex">
            <p class="m-0"><a asp-controller="Home" asp-action="Index">Home</a></p>
            <p class="m-0 px-2">-</p>
            <p class="m-0"><a asp-action="Index">Shop</a></p>
            <p class="m-0 px-2">-</p>
            <p class="m-0">Details</p>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <div class="col-lg-5 pb-5">
            <div class="border p-4 detail-image-shell">
                <img class="w-100" src="@StorefrontAssetHelper.GetProductImage(Model.Product.Id, Model.Product.ImageUrl)" alt="@Model.Product.Name">
            </div>
        </div>

        <div class="col-lg-7 pb-5">
            <span class="badge badge-primary text-uppercase mb-3">@Model.Product.CategoryName</span>
            <h3 class="font-weight-semi-bold">@Model.Product.Name</h3>
            <h3 class="font-weight-semi-bold mb-4">@Model.Product.Price.ToString("C")</h3>
            <div class="mb-4">
                <p class="mb-2">
                    <strong>Rating:</strong>
                    @if (Model.AverageRating.HasValue)
                    {
                        @($"{Model.AverageRating.Value:0.0} / 5")
                    }
                    else
                    {
                        @:No ratings yet
                    }
                </p>
                <p class="mb-0"><strong>Reviews:</strong> @Model.ReviewCount</p>
            </div>
            <p class="mb-4 product-description">
                @(string.IsNullOrWhiteSpace(Model.Product.Description)
                    ? "This product does not have a detailed description yet. You can add one from the admin dashboard to make the storefront feel even more complete."
                    : Model.Product.Description)
            </p>

            <div class="d-flex flex-wrap mb-4">
                <span class="store-metric"><i class="fas fa-box text-primary"></i>@(Model.Product.StockQuantity > 0 ? $"{Model.Product.StockQuantity} items in stock" : "Currently out of stock")</span>
                <span class="store-metric"><i class="fas fa-tags text-primary"></i>@Model.Product.CategoryName</span>
                <span class="store-metric"><i class="fas fa-database text-primary"></i>Connected to MVC data</span>
            </div>

            <div class="dashboard-actions">
                @if (Model.Product.StockQuantity > 0)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline-block">
                        <input type="hidden" name="id" value="@Model.Product.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-shopping-cart mr-2"></i>Add To Cart
                        </button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-outline-primary">Back To Shop</a>
                <a asp-action="Index" asp-route-categoryId="@Model.Product.CategoryId" class="btn btn-outline-secondary">More In @Model.Product.CategoryName</a>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">Browse Categories</a>
            </div>
        </div>
    </div>

    <div class="row px-xl-5">
        <div class="col-12">
            <div class="nav nav-tabs justify-content-center border-secondary mb-4">
                <a class="nav-item nav-link active" data-toggle="tab" href="#tab-pane-1">Description</a>
                <a class="nav-item nav-link" data-toggle="tab" href="#tab-pane-2">Product Info</a>
            </div>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-pane-1">
                    <h4 class="mb-3">Product Description</h4>
                    <p class="product-description">
                        @(string.IsNullOrWhiteSpace(Model.Product.Description)
                            ? "Add a product description from the admin side to enrich this page with specs, benefits, or selling points."
                            : Model.Product.Description)
                    </p>
                </div>
                <div class="tab-pane fade" id="tab-pane-2">
                    <h4 class="mb-3">Additional Information</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0">Category: @Model.Product.CategoryName</li>
                                <li class="list-group-item px-0">Price: @Model.Product.Price.ToString("C")</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0">Stock: @Model.Product.StockQuantity</li>
                                <li class="list-group-item px-0">Product ID: @Model.Product.Id</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <div class="col-lg-5 mb-5">
            <div class="border p-4 h-100">
                <h4 class="font-weight-semi-bold mb-3">Customer Reviews</h4>
                <p class="mb-2">
                    <strong>Average Rating:</strong>
                    @(Model.AverageRating.HasValue ? $"{Model.AverageRating.Value:0.0} / 5" : "No ratings yet")
                </p>
                <p class="mb-4"><strong>Total Reviews:</strong> @Model.ReviewCount</p>

                @if (User.IsInRole("Customer"))
                {
                    <h5 class="font-weight-semi-bold mb-3">
                        @(Model.CurrentUserReview is null ? "Write a Review" : "Update Your Review")
                    </h5>
                    <form asp-controller="Reviews"
                          asp-action="@(Model.CurrentUserReview is null ? "Create" : "Update")"
                          asp-route-id="@Model.CurrentUserReview?.Id"
                          method="post">
                        <input asp-for="ReviewForm.ProductId" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group">
                            <label asp-for="ReviewForm.Rating"></label>
                            <select asp-for="ReviewForm.Rating" class="form-control">
                                <option value="">Select a rating</option>
                                @for (var rating = 1; rating <= 5; rating++)
                                {
                                    <option value="@rating">@rating</option>
                                }
                            </select>
                            <span asp-validation-for="ReviewForm.Rating" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ReviewForm.Comment"></label>
                            <textarea asp-for="ReviewForm.Comment" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ReviewForm.Comment" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            @(Model.CurrentUserReview is null ? "Submit Review" : "Save Changes")
                        </button>
                    </form>

                    @if (Model.CurrentUserReview is not null)
                    {
                        <form asp-controller="Reviews"
                              asp-action="Delete"
                              asp-route-id="@Model.CurrentUserReview.Id"
                              method="post"
                              class="mt-3">
                            <input type="hidden" name="productId" value="@Model.Product.Id" />
                            <button type="submit" class="btn btn-outline-danger">Delete Review</button>
                        </form>
                    }
                }
                else
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <p class="mb-0">Only customer accounts can create, edit, or delete reviews.</p>
                    }
                    else
                    {
                        <p class="mb-0">
                            <a asp-controller="Account" asp-action="Login">Log in</a> with a customer account to add your review.
                        </p>
                    }
                }
            </div>
        </div>
        <div class="col-lg-7 mb-5">
            <div class="border p-4 h-100">
                <h4 class="font-weight-semi-bold mb-3">What Customers Are Saying</h4>

                @if (Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                                <strong>@review.ReviewerName</strong>
                                <small class="text-muted">@review.UpdatedAt.ToLocalTime().ToString("g")</small>
                            </div>
                            <p class="mb-2"><strong>Rating:</strong> @review.Rating / 5</p>
                            <p class="mb-0">@review.Comment</p>
                        </div>
                    }
                }
                else
                {
                    <p class="mb-0">No reviews have been submitted for this product yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5">
    <div class="text-center mb-4">
        <h2 class="section-title px-5"><span class="px-2">You May Also Like</span></h2>
    </div>
    <div class="row px-xl-5">
        @if (Model.RelatedProducts.Any())
        {
            @foreach (var product in Model.RelatedProducts)
            {
                <partial name="_StoreProductCard" model="product" />
            }
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <p>No related products were found yet.</p>
                    <a asp-action="Index" class="btn btn-primary">Browse All Products</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
