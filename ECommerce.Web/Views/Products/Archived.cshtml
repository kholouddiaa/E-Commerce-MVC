@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Archived Products";
}

<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="page-header">
                <div>
                    <h1>Archived Products</h1>
                    <p class="text-muted mb-0">Restore products when they should return to the storefront.</p>
                </div>
                <div class="dashboard-actions">
                    <a asp-action="Admin" class="btn btn-outline-secondary">Back to Products</a>
                    <a asp-action="Create" class="btn btn-primary">Create Product</a>
                </div>
            </div>

            <div class="card card-shadow border-0">
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <p>No archived products found.</p>
                            <a asp-action="Admin" class="btn btn-outline-primary">Back to Products</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th class="table-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model)
                                    {
                                        <tr>
                                            <td>@product.Name</td>
                                            <td>@product.CategoryName</td>
                                            <td>@product.Price.ToString("C")</td>
                                            <td>@product.StockQuantity</td>
                                            <td class="table-actions">
                                                <form asp-action="Restore" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@product.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Restore</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
