@model ProductDto
@{
    var columnClass = ViewData["ProductCardColumnClass"] as string ?? "col-lg-4 col-md-6 col-sm-12 pb-1";
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="@columnClass">
    <div class="card product-item border-0 mb-4">
        <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
            <img class="img-fluid w-100" src="@StorefrontAssetHelper.GetProductImage(Model.Id, Model.ImageUrl)" alt="@Model.Name">
        </div>
        <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
            <span class="d-block text-primary font-weight-semi-bold product-card-category mb-2">@Model.CategoryName</span>
            <h6 class="text-truncate mb-3 px-3">@Model.Name</h6>
            <div class="d-flex justify-content-center">
                <h6>@Model.Price.ToString("C")</h6>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center bg-light border">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm text-dark p-0">
                <i class="fas fa-eye text-primary mr-1"></i>View Detail
            </a>
            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="fas fa-shopping-cart mr-1"></i>Add To Cart
                    </button>
                </form>
            }
            else
            {
                <span class="text-dark small">
                    <i class="fas fa-box text-primary mr-1"></i>Out of stock
                </span>
            }
        </div>
    </div>
</div>
